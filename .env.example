# ------------------------------------------------------------------
# Banco — Supabase (Project Settings > Database > Connection string)
# ------------------------------------------------------------------
# Use a connection string do POOLER (porta 6543) na aplicação:
DATABASE_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# E a conexão DIRETA (porta 5432) para as migrações:
DIRECT_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------
# Sessão do painel do organizador
# ------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSAO_SEGREDO="troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres"

# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Domínios liberados para next/image (o do seu Supabase Storage), separados por vírgula
NEXT_PUBLIC_IMAGE_HOSTS="SEUPROJETO.supabase.co"

# ------------------------------------------------------------------
# Seed — primeiro organizador criado por `npm run db:seed`
# ------------------------------------------------------------------
ORGANIZADOR_NOME="Nome do organizador"
ORGANIZADOR_EMAIL="organizador@exemplo.com.br"
ORGANIZADOR_SENHA="troque-esta-senha"
ORGANIZADOR_WHATSAPP="+5537999999999"
ORGANIZADOR_CHAVE_PIX="37999999999"
ORGANIZADOR_TIPO_CHAVE_PIX="telefone"
ORGANIZADOR_INSTAGRAM="@moveon.corridas"
